# CodeLoop AI Environment Configuration

# Provider Options:
# 1. OpenRouter (Recommended for free/cheap multi-model access)
#    Get key from: https://openrouter.ai/keys
#    Starts with: sk-or-v1-...
#
# 2. Google Gemini
#    Get key from: https://aistudio.google.com/app/apikey
#    Starts with: AQ... or AIzaSy...
#
# 3. OpenAI
#    Get key from: https://platform.openai.com/api-keys
#    Starts with: sk-...

# API Keys (Provider is auto-detected from key prefix)
CODER_API_KEY=your_coder_api_key_here
CRITIC_API_KEY=your_critic_api_key_here

# Optional: Shared fallback key (used if individual keys are not set)
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Model overrides (defaults: openrouter/auto, gemini-2.5-flash, or gpt-4o-mini)
# CODER_MODEL=openrouter/auto
# CRITIC_MODEL=openrouter/auto

# Optional: Base URL overrides (auto-configured based on provider)
# CODER_BASE_URL=https://openrouter.ai/api/v1
# CRITIC_BASE_URL=https://openrouter.ai/api/v1
